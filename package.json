{
	"name": "zero-svelte",
	"version": "2.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"dev:zero-cache": "zero-cache-dev",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"release": "changeset publish",
		"changeset": "changeset",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"sync": "svelte-kit sync",
		"verify": "npm run format:check && npm run lint && npm run check && npm run build && npm run package",
		"dev:db-up": "docker compose --env-file .env -f ./docker/docker-compose.yml up",
		"dev:db-down": "docker compose --env-file .env -f ./docker/docker-compose.yml down"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.15.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/eslint": "^9.6.1",
		"@types/pg": "^8.20.0",
		"arktype": "^2.2.3",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.5",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.21",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.4",
		"zod": "^4.4.3"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/stolinski/zero-svelte"
	},
	"dependencies": {
		"@rocicorp/zero": "^1.8.0",
		"pg": "^8.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	}
}
